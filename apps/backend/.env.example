# -----------------------------------------------------------------------
# Database (Supabase Postgres connection string, pooled via pgbouncer)
# -----------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres"

# -----------------------------------------------------------------------
# Supabase Auth (used to verify the Google OAuth JWT sent by the frontend)
# -----------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWT_SECRET="<supabase-project-jwt-secret>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# -----------------------------------------------------------------------
# Authorization
# -----------------------------------------------------------------------
# Comma-separated list of emails granted the Admin role. Checked before
# the Students/Professors table lookup in the role-resolution flow.
ADMIN_EMAILS="admin1@iitdh.ac.in,admin2@iitdh.ac.in"

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
